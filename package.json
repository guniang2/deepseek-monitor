{
  "name": "deepseek-monitor",
  "version": "1.2.0",
  "description": "A sleek desktop app for monitoring DeepSeek account balance, API usage, and spending trends in real time",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.deepseek.monitor",
    "productName": "DeepSeek Monitor",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "guniang2",
      "repo": "deepseek-monitor"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-monitor",
    "monitor",
    "api-monitor",
    "balance-checker",
    "usage-tracker",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "Maxiaowen",
    "email": "leej95@163.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "x11": "^3.9.0"
  }
}
